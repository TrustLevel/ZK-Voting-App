# ════════════════════════════════════════════════════════════════════════════
# ZK-Voting-App deploy config (preview branch, Cardano preprod).
# Copy to `deploy/.env` and fill in. Compose auto-loads it when you run from
# this directory. NEVER commit the filled-in .env (it is gitignored).
# ════════════════════════════════════════════════════════════════════════════

# ── Domains (Caddy + URL wiring) ────────────────────────────────────────────
# Both must point at this VPS via DNS A/AAAA records BEFORE first `up`
# (Caddy needs them resolvable to issue TLS certs). See DEPLOY.md → DNS.
DOMAIN=vote.example.com              # public frontend hostname
API_DOMAIN=api.vote.example.com      # backend API hostname
ACME_EMAIL=you@example.com           # Let's Encrypt notices (optional, may be blank)

# ── Blockfrost (Cardano preprod data provider) ──────────────────────────────
# Backend (server-side) key.
BLOCKFROST_API_KEY=preprod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Frontend (browser) key — INTENTIONALLY exposed in the client bundle on the
# preview architecture (CIP-30 wallet signing). Acceptable on preprod testnet:
# quota-exhaustion risk only, no funds at stake. Use a SEPARATE key from the
# backend one so you can rotate/revoke it independently. See DEPLOY.md.
NEXT_PUBLIC_BLOCKFROST_API_KEY=preprod_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string — `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_secret

# ── Email invitations (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# IMPORTANT: the Resend sandbox sender only delivers to YOUR OWN Resend-account
# email. To invite arbitrary recipients you MUST verify a domain at
# resend.com/domains and set this to an address on that domain.
RESEND_FROM_EMAIL=invitations@vote.example.com

# ── NOTE ─────────────────────────────────────────────────────────────────────
# PORT (3001), BLOCKFROST_NETWORK (preprod), DATABASE_PATH, CORS_ORIGIN,
# FRONTEND_URL, and NEXT_PUBLIC_BACKEND_API_URL are set authoritatively in
# docker-compose.yml from DOMAIN/API_DOMAIN — you do NOT set them here.
