# ════════════════════════════════════════════════════════════════════════════
# ZK-Voting-App deploy config (preview branch, Cardano preprod).
# Copy to `deploy/.env` and fill in. Compose auto-loads it when you run from
# this directory. NEVER commit the filled-in .env (it is gitignored).
# ════════════════════════════════════════════════════════════════════════════

# ── Domains (Caddy + URL wiring) ────────────────────────────────────────────
# Both must point at this VPS via DNS A/AAAA records BEFORE first `up`
# (Caddy needs them resolvable to issue TLS certs). See DEPLOY.md → DNS.
DOMAIN=vote.example.com              # public frontend hostname
API_DOMAIN=api.vote.example.com      # backend API hostname
ACME_EMAIL=you@example.com           # Let's Encrypt notices (optional, may be blank)

# ── Networks ────────────────────────────────────────────────────────────────
# One deployment serves Preprod and Mainnet side by side; the organiser picks the
# network per event. A network is enabled when it has a Blockfrost key, a relay
# wallet and a VKey reference UTxO. Preprod-only deployments leave the *_MAINNET
# variables empty and keep working unchanged.

# ── Blockfrost (per network, backend only) ───────────────────────────────────
# One key per network, used only by the backend: votes are relayed and the organiser's
# publish transactions are built, submitted and watched server-side. The browser holds
# no Blockfrost key. BLOCKFROST_API_KEY is the Preprod key (legacy name, still
# honoured); BLOCKFROST_API_KEY_PREPROD takes precedence when set.
BLOCKFROST_API_KEY=preprod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BLOCKFROST_API_KEY_MAINNET=

# ── Relay wallets (pay vote tx fees + collateral; voters never sign) ─────────
# 24-word mnemonics. The backend builds, signs and submits every vote tx with the
# wallet of the event's network. Keep them out of git and chat.
# Preprod: a wallet with a few hundred tADA (RELAY_WALLET_MNEMONIC is the legacy
# name, still honoured; RELAY_WALLET_MNEMONIC_PREPROD takes precedence when set).
RELAY_WALLET_MNEMONIC=word1 word2 ... word24
# Mainnet: a SEPARATE hot wallet with real ADA — only the collateral UTxO (≥ 5 ADA,
# plain ADA) plus a small margin; organisers prepay their voters' fees per event
# (fee deposit, see docs/MAINNET_SETUP.md). Never reuse the Preprod mnemonic.
RELAY_WALLET_MNEMONIC_MAINNET=

# ── VKey reference UTxO (Mainnet) ───────────────────────────────────────────
# <txhash>#<index> of the Groth16 verification-key UTxO deployed once on Mainnet
# with src/tx/scripts/deploy-vkey.ts (docs/MAINNET_SETUP.md). Preprod uses the
# constant in src/tx/src/network.ts. Mainnet stays disabled until this is set.
VKEY_REF_MAINNET=

# ── Fee deposit ─────────────────────────────────────────────────────────────
# Networks on which the organiser must prepay the voters' fees (registered voters
# × 1.3 ADA) before publishing. Default: mainnet. Add preprod to rehearse the
# deposit flow with test ADA, e.g. FEE_DEPOSIT_NETWORKS=mainnet,preprod
#FEE_DEPOSIT_NETWORKS=mainnet

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string — `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_secret

# ── Email invitations (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# IMPORTANT: the Resend sandbox sender only delivers to YOUR OWN Resend-account
# email. To invite arbitrary recipients you MUST verify a domain at
# resend.com/domains and set this to an address on that domain.
RESEND_FROM_EMAIL=invitations@vote.example.com

# ── NOTE ─────────────────────────────────────────────────────────────────────
# PORT (3001), DATABASE_PATH, CORS_ORIGIN, FRONTEND_URL, and
# NEXT_PUBLIC_BACKEND_API_URL are set authoritatively in docker-compose.yml from
# DOMAIN/API_DOMAIN — you do NOT set them here. BLOCKFROST_NETWORK is no longer
# used: the network is a property of each event.
