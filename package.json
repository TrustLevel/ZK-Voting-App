{
  "name": "zk-voting-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/backend",
    "src/frontend",
    "src/tx",
    "src/zk"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev": "npm run dev --workspaces",
    "install:tx": "cd src/tx && npm install",
    "build:tx": "cd src/tx && npm run build",
    "postinstall": "cd node_modules/modp-semaphore-bls12381/packages/typescript && npm install && npx tsc"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.2",
    "circomlib": "^2.0.5",
    "poseidon-bls12381-circom": "^1.0.0"
  },
  "devDependencies": {
    "dotenv": "^16.0.3",
    "typescript": "^5.7.3"
  }
}
