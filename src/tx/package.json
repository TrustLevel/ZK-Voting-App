{
  "name": "@src/tx",
  "version": "1.0.0",
  "description": "Transaction building utilities for ZK Voting App",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "extract-validators": "tsx scripts/extract-validators.ts",
    "check-validators": "tsx scripts/check-validators-fresh.ts",
    "build": "npm run check-validators && tsc",
    "build:force": "npm run extract-validators && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@meshsdk/core": "^1.9.0",
    "@meshsdk/core-csl": "^1.9.0",
    "@src/zk": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "import": "./dist/builders/index.js",
      "require": "./dist/builders/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.js"
    }
  }
}
