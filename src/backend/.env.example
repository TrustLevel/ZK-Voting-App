# Server Configuration
PORT=3000

# Blockfrost API Configuration
BLOCKFROST_API_KEY=your_blockfrost_api_key_here
BLOCKFROST_NETWORK=preview

# Database Configuration
DATABASE_PATH=db/voting-app.db

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
# Use a verified Resend domain for production. For local dev, omit this to use the sandbox sender.
# Sandbox (onboarding@resend.dev) can only deliver to your Resend account's registered email.
RESEND_FROM_EMAIL=your_email_to_send_mails

FRONTEND_URL=http://localhost:3002
