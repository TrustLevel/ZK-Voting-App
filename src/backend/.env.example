# Server Configuration
PORT=3000

# Blockfrost API Configuration — one key per network. BLOCKFROST_API_KEY is the
# Preprod key (legacy name); BLOCKFROST_API_KEY_PREPROD takes precedence when set.
# A network without a key, a relay wallet and a VKey reference UTxO is not enabled.
BLOCKFROST_API_KEY=preprod_your_blockfrost_api_key_here
BLOCKFROST_API_KEY_MAINNET=

# Database Configuration
DATABASE_PATH=db/voting-app.db

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Relay wallets — sign and submit vote transactions on behalf of voters, one per
# network. 24-word mnemonics; the wallet pays tx fees and holds the collateral UTxO.
# RELAY_WALLET_MNEMONIC is the Preprod wallet (legacy name; RELAY_WALLET_MNEMONIC_PREPROD
# takes precedence). Mainnet needs its own wallet with real ADA — see docs/MAINNET_SETUP.md.
RELAY_WALLET_MNEMONIC=word1 word2 ... word24
RELAY_WALLET_MNEMONIC_MAINNET=

# VKey reference UTxO on Mainnet (<txhash>#<index>), deployed once with
# src/tx/scripts/deploy-vkey.ts. Preprod uses the constant in src/tx/src/network.ts.
VKEY_REF_MAINNET=

# Networks on which organisers prepay their voters' fees before publishing
# (registered voters × 1.3 ADA). Default mainnet; add preprod to rehearse with tADA.
#FEE_DEPOSIT_NETWORKS=mainnet

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
# Use a verified Resend domain for production. For local dev, omit this to use the sandbox sender.
# Sandbox (onboarding@resend.dev) can only deliver to your Resend account's registered email.
RESEND_FROM_EMAIL=your_email_to_send_mails

FRONTEND_URL=http://localhost:3002
